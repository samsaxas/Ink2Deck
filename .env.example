# Copy to .env and fill in. Never commit .env.
SECRET_KEY=

# MongoDB connection (optional; leave empty for SQLite)
MONGO_URI=

# Gemini-only image transcription. No local OCR fallback exists.
GEMINI_API_KEY=
# Optional comma-separated additional keys. Prefer keys from separate projects;
# keys in the same Google Cloud project share project-level quotas.
GEMINI_API_KEYS=

# Primary model followed by fallback models, tried in order.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_RETRIES=1
GEMINI_RETRY_DELAY_SECONDS=1.5

COOKIE_SECURE=0
COOKIE_SAMESITE=lax
